{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "O resultado serve para comprar direto no depósito?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, como estimativa. Sempre confirme o quantitativo com o fornecedor, que pode indicar embalagens (pallets, milheiros) e políticas de troca de sobras. Compre com pequena margem para evitar viagens extras."
      }
    },
    {
      "@type": "Question",
      "name": "Como ajustar o desperdício conforme a parede?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use 5% para paredes retas e sem muitos vãos. Para paredes com portas, janelas, nichos ou muitos recortes, aumente para 8–10%. Alvenarias curvas ou com blocos frágeis podem exigir 12%."
      }
    },
    {
      "@type": "Question",
      "name": "Como calcular paredes com formatos irregulares?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Divida a parede em retângulos e triângulos, calcule a área de cada trecho e some. Subtraia apenas vãos maiores que 1 m² (portas e janelas grandes). Para muros com escalonamento, calcule cada seção separadamente."
      }
    }
  ]
}
